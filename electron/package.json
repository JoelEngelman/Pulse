{
  "name": "pulse-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse desktop application",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.joelengelman.pulse",
    "productName": "Pulse",
    "asar": true,
    "files": ["main.cjs", "preload.cjs", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "../artifacts/chat-app/public/favicon.ico" },
    "mac": { "target": ["dmg", "zip"], "icon": "../artifacts/chat-app/public/favicon.ico" },
    "linux": { "target": ["AppImage", "deb"], "category": "Network", "icon": "../artifacts/chat-app/public/favicon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
